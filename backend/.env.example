# Copie para backend/.env e preencha os valores.
# O .env nao e versionado.

# Porta em que a API escuta
PORTA=8080

# Interface de escuta.
# 0.0.0.0 = responde em toda a rede local (bom para testar pelo celular).
# 127.0.0.1 = só localmente — use assim atras de um proxy reverso, senao a API
# continua alcancavel na porta 8080 sem passar pelo HTTPS.
HOST_BIND=0.0.0.0

# Conexao PostgreSQL.
# Os nomes usam prefixo DB_ de proposito: variaveis como USER e HOST ja existem
# no ambiente em Linux/macOS, e o dotenv nao sobrescreve o que ja esta definido.
DB_USER=
DB_HOST=localhost
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# Segredo de assinatura do JWT. Gere um proprio, nunca reutilize exemplos:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TOKEN_SEG=

# Origens liberadas no CORS, separadas por ponto e virgula.
# Vazio = nenhuma origem liberada.
ENABLE_CORS=http://localhost:5173

# Quantos proxies reversos existem na frente da API.
# 0 = exposta direto. Use 1 se ficar atras de Caddy/nginx — sem isso o
# limitador por IP enxerga todo mundo como 127.0.0.1.
PROXIES_CONFIAVEIS=0

# Limite de tentativas de login por IP+CPF (defesa contra forca bruta).
# Tentativas bem-sucedidas nao contam.
LIMITE_LOGIN_JANELA_MS=900000
LIMITE_LOGIN_MAXIMO=20

# Teto geral de requisicoes por IP.
LIMITE_GERAL_JANELA_MS=60000
LIMITE_GERAL_MAXIMO=300
