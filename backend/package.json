{
  "name": "gym-sys-backend",
  "version": "2.0.0",
  "description": "API RESTful do Gym Sys para gestão de alunos, professores e treinos.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
    "criar-professor": "node scripts/criarProfessor.js",
    "demo": "node scripts/demo.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jose": "^6.2.9",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
